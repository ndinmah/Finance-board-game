{
  "name": "webopoly",
  "private": true,
  "engines": {
    "node": ">=22.6.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "@colyseus/schema": "2.0.35"
  }
}
